<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.osgi</groupId>
		<artifactId>org.osgi.service.typedevent.reactor</artifactId>
		<version>${revision}</version>
	</parent>
	<groupId>org.osgi.tck</groupId>
	<artifactId>org.osgi.tck.service.typedevent</artifactId>
	<packaging>pom</packaging>

	<!-- The versions of the TCK test runtime, in one place. The names are the
	     ones org.osgi.maven.pom.parent defines, so its dependencyManagement
	     follows them too, and tck.bndrun reads the same properties: a bump
	     here (by hand or by Dependabot) changes the poms and the run together. -->
	<properties>
		<junit-jupiter.version>5.8.2</junit-jupiter.version>
		<junit-platform.version>1.8.2</junit-platform.version>
		<opentest4j.version>1.2.0</opentest4j.version>
		<assertj.version>3.23.1</assertj.version>
		<mockito.version>4.6.1</mockito.version>
		<byte-buddy.version>1.12.10</byte-buddy.version>
		<objenesis.version>3.2</objenesis.version>
		<osgi-test.version>1.4.0-SNAPSHOT</osgi-test.version>
	</properties>
	<modules>
		<module>org.osgi.test.cases.typedevent</module>
		<module>org.osgi.test.run.typedevent</module>
	</modules>

</project>
