<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.osgi</groupId>
		<artifactId>org.osgi.service.typedevent.reactor</artifactId>
		<version>${revision}</version>
	</parent>
	<groupId>org.osgi.tck</groupId>
	<artifactId>org.osgi.tck.service.typedevent</artifactId>
	<packaging>pom</packaging>

	<!-- The versions of the TCK test runtime, in one place. The names are the
	     ones org.osgi.maven.pom.parent defines, so its dependencyManagement
	     follows them too, and tck.bndrun reads the same properties: a bump
	     here (by hand or by Dependabot) changes the poms and the run together. -->
	<properties>
		<junit-jupiter.version>6.1.3</junit-jupiter.version>
		<junit-platform.version>6.1.3</junit-platform.version>
		<opentest4j.version>1.3.0</opentest4j.version>
		<assertj.version>3.27.7</assertj.version>
		<mockito.version>4.6.1</mockito.version>
		<byte-buddy.version>1.18.14</byte-buddy.version>
		<objenesis.version>3.2</objenesis.version>
		<osgi-test.version>1.4.0-SNAPSHOT</osgi-test.version>
		<org.apache.felix.configadmin.version>1.9.26</org.apache.felix.configadmin.version>
		<org.osgi.service.cm.version>1.6.0</org.osgi.service.cm.version>
		<org.apache.aries.typedevent.bus.version>1.1.0-SNAPSHOT</org.apache.aries.typedevent.bus.version>
		<org.apache.aries.component-dsl.component-dsl.version>1.2.2</org.apache.aries.component-dsl.component-dsl.version>
		<org.apache.felix.scr.version>2.2.18</org.apache.felix.scr.version>
		<org.osgi.service.component.version>1.5.1</org.osgi.service.component.version>
		<org.osgi.util.function.version>1.2.0</org.osgi.util.function.version>
		<org.osgi.util.promise.version>1.3.0</org.osgi.util.promise.version>
		<org.osgi.util.pushstream.version>1.1.0</org.osgi.util.pushstream.version>
		<org.osgi.util.converter.version>1.0.9</org.osgi.util.converter.version>
		<slf4j-api.version>1.7.36</slf4j-api.version>
		<slf4j-simple.version>1.7.36</slf4j-simple.version>
		<org.eclipse.osgi.version>3.24.300</org.eclipse.osgi.version>
	</properties>
	<modules>
		<module>org.osgi.test.cases.typedevent</module>
		<module>org.osgi.test.run.typedevent</module>
	</modules>

</project>
